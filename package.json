{
  "name": "courseflix",
  "version": "1.0.0",
  "description": "Browse every University of Toronto Mississauga course like Netflix: program-aware recommendations, student reviews, shortlists and friends.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Abood Awaida",
  "homepage": "https://www.courseflix.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/aboodgitawaida/courseflix.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "reddit-reviews": "node scripts/scrape-reddit-reviews.mjs",
    "reddit-context": "node scripts/add-reddit-context.mjs",
    "reddit-classify": "node scripts/classify-reddit-reviews.mjs",
    "reddit-rank": "node scripts/reddit-rank.mjs",
    "reddit-signals": "node scripts/build-reddit-signals.mjs",
    "reddit-spot-check": "node scripts/spot-check-reddit-labels.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-plugin": "1.168.48",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.27.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
