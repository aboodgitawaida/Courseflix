# Copy to .env and fill in. Never commit real values (.env and .env.* are gitignored).

# --- Required: the app ---------------------------------------------------------
# Supabase project (Settings -> API). The publishable key is safe in the browser;
# row-level security protects the data.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# The same values for server-side code (SSR and server functions).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
SUPABASE_PROJECT_ID="your-project-id"

# --- Server-only secrets -------------------------------------------------------
# Never prefix these with VITE_: anything VITE_ is shipped to the browser.

# Password-reset and verification emails (admin auth calls + Resend).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
RESEND_API_KEY="re_your-resend-key"

# Optional. Screens new reviews with Claude; without it reviews publish unchecked.
ANTHROPIC_API_KEY="sk-ant-your-key"

# --- Optional: offline data scripts (scripts/), not used by the running site ----
# Reddit easy/hard labelling (npm run reddit-classify). Uses Claude if
# ANTHROPIC_API_KEY is set, else Gemini, else a local Ollama model.
GEMINI_API_KEY=""
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL=""

# Study Eagle sprite generation (scripts/pixellab.py).
PIXELLAB_API_KEY=""
