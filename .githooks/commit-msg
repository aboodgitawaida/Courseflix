#!/bin/sh
# Enforces Conventional Commits on the first line of every commit message.
# Enable once per clone with: npm run hooks:install
first_line=$(head -n1 "$1")

# Let git's own merge, revert and fixup messages through.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message must follow Conventional Commits, for example:" >&2
  echo "  feat(eagle): power up on gold courses" >&2
  echo "  fix(auth): reject redirect targets with control characters" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "Got: $first_line" >&2
  exit 1
fi
